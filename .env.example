# ==============================================================================
# Fizgo Digital · Propostas & Contratos - Variáveis de Ambiente (.env)
# ==============================================================================

# Porta do servidor local (padrão: 3005 para evitar conflitos na porta 3000)
PORT=3005

# Token de API do Autentique (opcional se já inserido na interface web em Configurações)
# Obtenha em: https://painel.autentique.com.br/perfil/api
AUTENTIQUE_TOKEN=

# Endpoint da API GraphQL do Autentique
AUTENTIQUE_URL=https://api.autentique.com.br/v2/graphql
